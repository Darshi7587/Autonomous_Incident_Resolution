# NEXUS AI Configuration

# Application Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=nexus-ai-enterprise-secret-key-change-in-production
DEBUG=True

# Database Configuration (SQLite default for rapid local setup, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./data/nexus_ai.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_password@localhost:5432/nexus_ai

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Prometheus Integration
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SECONDS=10

# Grafana Loki Integration
LOKI_URL=http://localhost:3100
LOKI_TIMEOUT_SECONDS=10

# Docker Engine Integration
DOCKER_HOST=npipe:////./pipe/docker_engine
# Linux alternative: DOCKER_HOST=unix:///var/run/docker.sock

# OpenTelemetry Collector
OTEL_COLLECTOR_URL=http://localhost:4318

# LLM & Cognitive Engine
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional Cloud Provider alternatives (fallback/hosted):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Anomaly Detection Parameters
ANOMALY_SENSITIVITY=2.5
DYNAMIC_BASELINE_WINDOW=50
ISOLATION_FOREST_CONTAMINATION=0.05

# Remediation Security Policy
AUTO_APPROVE_LOW_RISK=True
REQUIRE_HUMAN_APPROVAL_HIGH_RISK=True
REMEDIATION_TIMEOUT_SECONDS=60
